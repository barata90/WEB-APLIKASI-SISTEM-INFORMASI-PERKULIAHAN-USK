digraph G {
  graph [rankdir=TB, fontname="Inter", fontsize=14, nodesep=0.6, ranksep=0.55, pad=0.3, bgcolor="white"];
  node  [fontname="Inter", fontsize=13, shape=box, style="rounded,filled", fillcolor="#eef2ff", color="#1e3a8a", penwidth=1.4];
  edge  [fontname="Inter", fontsize=12, color="#334155", penwidth=1.3];

  subgraph cluster_client {
    label="KLIEN"; style="rounded,dashed"; color="#94a3b8"; fontcolor="#334155";
    browser [label="Browser\n(Chrome / Firefox / Edge)\nHTML, CSS, JavaScript", fillcolor="#fef3c7", color="#b45309"];
    user [label="Pengguna\nAdmin · Dosen · Mahasiswa", shape=oval, fillcolor="#ffffff"];
    { rank=same; user; browser; }
  }

  subgraph cluster_server {
    label="SERVER (localhost, Ubuntu 24.04)"; style="rounded"; color="#1e3a8a"; fontcolor="#1e3a8a";
    apache [label="Apache HTTP Server 2.4.58\nport 80\nmod_rewrite · .htaccess · Alias /siakad"];
    php [label="PHP 8.3 (mod_php)\nindex.php (front controller)\nRouter → Controller → Model → View"];
    session [label="Session PHP\n(login, peran, CSRF token)", fillcolor="#f8fafc"];
    { rank=same; db; session; }
    db [label="MariaDB 10.11 (RDBMS)\nport 3306\ndb_siakad: 12 tabel + 3 view", shape=cylinder, fillcolor="#dcfce7", color="#15803d"];
  }

  user -> browser [label="  mengakses  ", style=dashed];
  browser -> apache [label="1. HTTP request\nGET/POST http://localhost/siakad/"];
  apache -> php [label="2. eksekusi skrip\n.php"];
  php -> session [dir=both, style=dashed, label=" baca/tulis "];
  php -> db [label="3. query SQL\n(PDO, prepared statement)"];
  db -> php [label="4. result set", style=dashed];
  php -> apache [label="5. HTML hasil render", style=dashed];
  apache -> browser [label="6. HTTP response\n(200 OK, text/html)", style=dashed];
}
