digraph Alur {
  graph [rankdir=TB, fontname="Inter", fontsize=14, nodesep=0.6, ranksep=0.42, pad=0.3];
  node  [fontname="Inter", fontsize=13, shape=box, style="rounded,filled", penwidth=1.4, width=4.2];
  edge  [fontname="Inter", fontsize=12, color="#334155", penwidth=1.3];

  a1 [label="1. ADMIN · Kelola data master\nfakultas, prodi, dosen, mahasiswa, mata kuliah, ruangan", fillcolor="#eef2ff", color="#1e3a8a"];
  a2 [label="2. ADMIN · Aktifkan tahun akademik (2026/2027 Ganjil)", fillcolor="#eef2ff", color="#1e3a8a"];
  a3 [label="3. ADMIN · Buka kelas & jadwal\nsistem menolak bentrok dosen/ruangan", fillcolor="#eef2ff", color="#1e3a8a"];
  m1 [label="4. MAHASISWA · Isi KRS (status: Diajukan)\ncek kuota, MK ganda, bentrok jadwal, maks. 24 SKS", fillcolor="#fef3c7", color="#b45309"];
  d1 [label="5. DOSEN WALI · Periksa KRS bimbingan", fillcolor="#dcfce7", color="#15803d"];
  d2 [label="6. DOSEN PENGAMPU · Input nilai Tugas, UTS, UAS", fillcolor="#dcfce7", color="#15803d"];
  s1 [label="7. SISTEM (view SQL) · v_nilai_akhir → v_ips → v_ipk\nNA = 30% Tugas + 30% UTS + 40% UAS → huruf & bobot", fillcolor="#f1f5f9", color="#475569", shape=box];
  m2 [label="8. MAHASISWA · Lihat KHS (IPS) dan transkrip (IPK)", fillcolor="#fef3c7", color="#b45309"];

  a1 -> a2 -> a3 -> m1 -> d1;
  d1 -> d2 [label="  Disetujui"];
  d1:e -> m1:e [label="  Ditolak: mahasiswa\n  merevisi KRS", style=dashed, color="#b91c1c", fontcolor="#b91c1c"];
  d2 -> s1 [label="  disimpan ke tabel nilai"];
  s1 -> m2;
}
